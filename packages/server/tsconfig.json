{
  "compilerOptions": {
    /* Output */
    "target": "ES2024",
    "lib": [
      "ES2024"
    ],
    "module": "Node20",
    "noEmit": true,
    "types": [
      "bun"
    ],
    /* Strictness */
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noImplicitAny": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    /* Imports */
    "allowImportingTsExtensions": true,
    "paths": {
      "$/*": [
        "./src/*"
      ]
    }
  }
}