{
  "compilerOptions": {
    /* Output */
    "target": "ES2024",
    "lib": [
      "ES2024"
    ],
    "module": "Node20",
    "noEmit": true,
    "types": [
      "node"
    ],
    /* Strictness */
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noImplicitAny": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    /* Imports */
    "allowImportingTsExtensions": true,
    "ignoreDeprecations": "6.0", /* Tsup@8.5.1 for some reason appears to think this file contains a "baseUrl" property, which causes the DTS phase to fail. */
    "paths": {
      "$/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}